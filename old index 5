  if(medCourseSel.size === 0){
    medCourseSummaryEl.textContent = "";
  } else {
    const withReqs = MED_SCHOOLS.filter(s => (MED_COURSE_REQS[s.name]||[]).length);
    const met = withReqs.filter(s => medCourseState(s) && medCourseState(s).cls==="open").length;
    const noReq = MED_SCHOOLS.length - withReqs.length;
    medCourseSummaryEl.textContent = `${noReq} schools have no course prerequisites. Of the ${withReqs.length} that do, your courses cover ${met}.`;
  }
  medGridEl.innerHTML = list.length ? list.map(s => {
    const cs = medCourseState(s);
    const hasReqs = (MED_COURSE_REQS[s.name]||[]).length > 0;
    const badge = cs ? `<span class="status ${cs.cls}">${cs.text}</span>`
      : (medCourseSel.size>0 && !hasReqs ? `<span class="status neutral">No specific course prerequisites</span>` : "");
    return `
    <article class="card">
      <div class="uni-name">${s.region} · ${s.prov} · ${s.seats} seats</div>
      <h3>${s.name}</h3>
      ${badge}
      <ul class="req">
        <li><span class="mark">•</span><span><strong>Degree:</strong> ${s.degree}</span></li>
        <li><span class="mark">•</span><span><strong>GPA:</strong> ${s.gpa}</span></li>
        <li><span class="mark">•</span><span><strong>MCAT:</strong> ${s.mcat}</span></li>
        <li><span class="mark">•</span><span><strong>CASPer:</strong> ${s.casper}</span></li>
        <li><span class="mark">•</span><span><strong>Prerequisites:</strong> ${s.prereq}</span></li>
      </ul>
      <div class="note">${s.note}</div>
      <div class="src">Official page: <a href="${s.url}" target="_blank" rel="noopener">visit</a> · AFMC 2026 · verified 2026-06-11</div>
    </article>`;
  }).join("") : `<p class="sub">No schools match those filters. Try removing one.</p>`;
}
