function medCourseState(s){
  const reqs = MED_COURSE_REQS[s.name];
  if(!reqs || !reqs.length) return null;
  if(medCourseSel.size === 0) return null;
  const labelOf = k => (MED_COURSES.find(c => c[0]===k)||[null,k])[1];
  const missing = reqs.filter(k => !medCourseSel.has(k));
  return missing.length === 0
    ? {cls:"open", text:"Course prerequisites met (GPA and MCAT still decide)"}
    : {cls:"missing", text:"Still needs: " + missing.map(labelOf).join(", ")};
}

function renderMed(){
  let list = medProv === "All" ? MED_SCHOOLS.slice() : MED_SCHOOLS.filter(s => s.prov === medProv);
