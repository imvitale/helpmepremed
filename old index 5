/* ---------- Field course-prerequisite checker ----------
   Each program's checkable course requirements are DERIVED from its already-verified
   `courses` prose, so the checker can never claim a requirement the card doesn't show.
   A program counts as "checkable" only if at least one course line maps to a known key. */
const FIELD_COURSE_VOCAB = [
  ["english","English",          /\benglish\b/i],
  ["ethics","Ethics",            /\bethic/i],
  ["psych","Psychology",         /\bpsych/i],
  ["bio","Biology",              /\bbiolog|life science|biological/i],
  ["microbio","Microbiology",    /\bmicrobiolog/i],
  ["anatomy","Human Anatomy",    /\banatom/i],
  ["physiology","Physiology",    /\bphysiolog/i],
  ["genchem","General Chemistry",/\b(general chemistry|inorganic|chemistry with lab|introductory chemistry|general chem)\b/i],
  ["orgchem","Organic Chemistry",/\borganic chem/i],
  ["biochem","Biochemistry",     /\bbiochem/i],
  ["physics","Physics",          /\bphysics\b/i],
  ["calculus","Calculus",        /\bcalculus|differential and integral/i],
  ["stats","Statistics",         /\bstatistic|research methods\b/i],
  ["humss","Humanities / Social Science", /\bhumanit|social science|sociology|social-?science/i]
];
// Lines that are NOT hard requirements must not generate course keys:
// vague pointers, recommendations, negations, or "options" lists.
const NO_COURSE_HINT = /(no (required|prerequisite|specific)|see the|official page|official french|no fixed|no prerequisite courses)/i;
const NOT_REQUIRED_LINE = /(recommend|do not count|does not count|not accepted|not count|not required|\basset\b|electives?:|from biology|helps the application|boosts the application|application boost)/i;

function deriveCReq(courses){
  const keys = new Set();
  let sawRealLine = false;
  (courses||[]).forEach(line => {
    if(NO_COURSE_HINT.test(line) || NOT_REQUIRED_LINE.test(line)){ return; }
    let matchedThisLine = false;
    FIELD_COURSE_VOCAB.forEach(([key,,re]) => { if(re.test(line)){ keys.add(key); matchedThisLine = true; } });
    if(matchedThisLine){ sawRealLine = true; }
  });
  return { keys:[...keys], checkable: sawRealLine };
}

let fieldKey = null, fieldCourseSel = new Set();
function fieldCourseState(p){
  const {keys, checkable} = deriveCReq(p.courses);
  if(!checkable) return {cls:"neutral", text:"No specific course list to check (see card)"};
  if(fieldCourseSel.size === 0) return null;
  const missing = keys.filter(k => !fieldCourseSel.has(k));
  const labelOf = k => (FIELD_COURSE_VOCAB.find(v => v[0]===k)||[null,k])[1];
  return missing.length === 0
    ? {cls:"open", text:"Your courses cover the prerequisites (GPA and tests still decide)"}
    : {cls:"missing", text:"Still needs: " + missing.map(labelOf).join(", ")};
}

function openField(key){
  const f = FIELDS[key];
  fieldKey = key; fieldCourseSel = new Set();
  document.getElementById("field-title").textContent = f.title;
  document.getElementById("field-sub").textContent = f.sub;
  document.getElementById("field-note").innerHTML = f.note;

  // Build the course-chip set from the union of derivable keys across this field's programs
  const unionKeys = [];
  f.programs.forEach(p => deriveCReq(p.courses).keys.forEach(k => { if(!unionKeys.includes(k)) unionKeys.push(k); }));
  const checkerEl = document.getElementById("field-checker");
  const coursesEl = document.getElementById("field-courses");
  coursesEl.innerHTML = "";
  if(unionKeys.length){
    checkerEl.style.display = "block";
    // order chips by the vocab order for consistency
    FIELD_COURSE_VOCAB.forEach(([k,label]) => {
      if(!unionKeys.includes(k)) return;
      const b = document.createElement("button");
      b.className = "chip"; b.setAttribute("aria-pressed","false"); b.textContent = label;
      b.onclick = () => {
        if(fieldCourseSel.has(k)) fieldCourseSel.delete(k); else fieldCourseSel.add(k);
        b.setAttribute("aria-pressed", fieldCourseSel.has(k) ? "true":"false");
        renderField();
      };
      coursesEl.appendChild(b);
    });
  } else {
    checkerEl.style.display = "none";
  }
  renderField();
  go("field");
}

function renderField(){
  const f = FIELDS[fieldKey];
  const summaryEl = document.getElementById("field-coursesummary");
  if(fieldCourseSel.size){
    const checkable = f.programs.filter(p => deriveCReq(p.courses).checkable);
    const covered = checkable.filter(p => { const st = fieldCourseState(p); return st && st.cls==="open"; }).length;
    summaryEl.textContent = `Your courses cover ${covered} of ${checkable.length} programs with a checkable course list.`;
  } else {
    summaryEl.textContent = "";
  }
  document.getElementById("field-grid").innerHTML = f.programs.map(p => {
    const st = fieldCourseState(p);
    const badge = st ? `<span class="status ${st.cls}">${st.text}</span>` : "";
    return `
    <article class="card">
      <div class="uni-name">${p.uni}</div>
      <h3>${p.name}</h3>
      ${badge}
      <div class="note"><strong>Degree:</strong> ${p.degree}</div>
      <div class="note"><strong>GPA:</strong> ${p.gpa}</div>
      <div class="note"><strong>Tests &amp; extras:</strong> ${p.test}</div>
      <div class="note" style="margin-top:4px"><strong>Required courses:</strong></div>
      <ul class="req">${p.courses.map(c => `<li><span class="mark">•</span><span>${c}</span></li>`).join("")}</ul>
      <div class="src">Source: <a href="${p.url}" target="_blank" rel="noopener">${p.src}</a> · verified 2026-06-11</div>
    </article>`;
  }).join("");
}

