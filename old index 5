// Anything absent has no specific course prerequisites. Quebec French CEGEP schools are excluded
// (their prereqs are CEGEP-level, not undergraduate courses).
const MED_COURSE_REQS = {
  "University of Ottawa": ["humss","bio","orgchem","genchem","biochem","stats"],
  "McGill University (MD-CM)": ["bio","genchem","physics","orgchem"],
  "University of Toronto (Temerty)": ["bio","humss"]
