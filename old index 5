  const b = document.createElement("button");
  b.className = "chip"; b.setAttribute("aria-pressed","false"); b.textContent = label;
  b.onclick = () => {
    if(medCourseSel.has(key)) medCourseSel.delete(key); else medCourseSel.add(key);
    b.setAttribute("aria-pressed", medCourseSel.has(key) ? "true":"false");
    renderMed();
