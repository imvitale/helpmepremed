/* ---------- Save / share Grade 12 plan ---------- */
function g12ClauseLabel(program, clause){
  return (program.labels && program.labels[clause.join(",")]) || clause.join(" or ");
}

function buildGrade12PlanText(){
  const chipsEl = document.getElementById("chips");
  const selected = chipsEl?._selectedCourses || new Set();
  const programs = chipsEl?._checkerPrograms || HS_PROGRAMS || [];
  const courses = chipsEl?._checkerCourses || HS_COURSES || [];
  const selectedNames = courses
    .filter(c => selected.has(c.code))
    .map(c => `${c.short} (${c.name})`);

  const openPrograms = [];
  const blockedPrograms = [];

  programs.forEach(p => {
    const missing = (p.req || []).filter(clause => !clause.some(code => selected.has(code)));
    const row = `${p.uni} — ${p.name}`;
    if(selected.size > 0 && missing.length === 0){
      openPrograms.push(row);
    } else {
      blockedPrograms.push({row, missing: missing.map(clause => g12ClauseLabel(p, clause))});
    }
  });

  const lines = [];
  lines.push("Help Me Pre Med — Grade 12 Plan");
  lines.push(`Generated from: ${location.origin}${location.pathname}#g12`);
  lines.push("");
  lines.push("Selected Grade 12 courses:");
  lines.push(selectedNames.length ? selectedNames.map(x => `- ${x}`).join("\n") : "- No courses selected yet");
  lines.push("");
  lines.push(`Open programs: ${openPrograms.length} of ${programs.length}`);
  lines.push(openPrograms.length ? openPrograms.map(x => `- ${x}`).join("\n") : "- None yet");
  lines.push("");
  lines.push("Blocked / missing requirements:");
  lines.push(blockedPrograms.length ? blockedPrograms.map(item => `- ${item.row}: missing ${item.missing.join("; ") || "course selection"}`).join("\n") : "- None");
  lines.push("");
  lines.push("Note: Open means the selected courses cover the published prerequisites shown on Help Me Pre Med. It does not guarantee admission. Always confirm requirements on the official university page before applying.");
  return lines.join("\n");
}

async function copyGrade12Plan(){
  const status = document.getElementById("shareStatus");
  const text = buildGrade12PlanText();

  try{
    if(navigator.share){
      await navigator.share({title:"My Help Me Pre Med plan", text});
      if(status) status.textContent = "Plan shared.";
      return;
    }
  } catch(err){
    // If the user cancels native share, fall through to copy.
  }

  try{
    await navigator.clipboard.writeText(text);
    if(status) status.textContent = "Plan copied. Paste it into an email, message, or document for your guidance counsellor.";
  } catch(err){
    const ta = document.createElement("textarea");
    ta.value = text;
    ta.setAttribute("readonly", "");
    ta.style.position = "fixed";
    ta.style.left = "-9999px";
    document.body.appendChild(ta);
    ta.select();
    document.execCommand("copy");
    document.body.removeChild(ta);
    if(status) status.textContent = "Plan copied. Paste it into an email, message, or document for your guidance counsellor.";
  }
}

