/* ---------- Compare 3 programs ---------- */
const COMPARE_SELECTED = [];

function compareEscape(value){
  return String(value ?? "").replace(/[&<>'"]/g, ch => ({"&":"&amp;","<":"&lt;",">":"&gt;","'":"&#39;",'"':"&quot;"}[ch]));
}

function compareBand(program){
  const map = {green:"Moderate (mid 80s)", amber:"Competitive (high 80s)", red:"Very competitive (90%+)"};
  return map[program.band] || "Not published / varies by year";
}

function compareClauseLabel(program, clause){
  return (program.labels && program.labels[clause.join(",")]) || clause.join(" or ");
}

function compareUndergradRow(program){
  const required = (program.req || []).map(cl => compareClauseLabel(program, cl)).join("; ");
  const extras = [];
  if((program.note || "").toLowerCase().includes("supplement")) extras.push("Supplementary application mentioned");
  if((program.note || "").toLowerCase().includes("casper")) extras.push("CASPer mentioned");
  return {
    type:"Undergraduate",
    title:`${program.uni} — ${program.name}`,
    uni:program.uni,
    name:program.name,
    required: required || "See official page",
    recommended: program.rec || "None listed",
    average: compareBand(program),
    tests: extras.length ? extras.join("; ") : "None listed in this card",
    source: program.src || "Official source",
    url: program.url || "#"
  };
}

function compareFieldRow(program, fieldName){
  return {
    type:fieldName,
    title:`${program.uni} — ${program.name}`,
    uni:program.uni,
    name:program.name,
    required:(program.courses || []).join("; ") || "See official page",
    recommended:"See required courses / official page",
    average:program.gpa || "Not published / varies",
    tests:program.test || "See official page",
    source:program.src || "Official source",
    url:program.url || "#"
  };
}

function compareMedRow(program){
  return {
    type:"Medicine",
    title:`${program.name}`,
    uni:program.name,
    name:"MD program",
    required:program.prereq || "No specific course prerequisites listed",
    recommended:"See official page",
    average:program.gpa || "Not published / varies",
    tests:`MCAT: ${program.mcat || "See site"}; CASPer: ${program.casper || "See site"}`,
    source:"Official page / AFMC",
    url:program.url || "#"
  };
}

function getComparePrograms(){
  const rows = [];
  (HS_PROGRAMS || []).forEach(p => rows.push(compareUndergradRow(p)));
  Object.entries(FIELDS || {}).forEach(([key, field]) => {
    (field.programs || []).forEach(p => rows.push(compareFieldRow(p, field.title || key)));
  });
  (MED_SCHOOLS || []).forEach(p => rows.push(compareMedRow(p)));

  const seen = new Set();
  return rows.filter(r => {
    const key = `${r.type}|${r.title}`.toLowerCase();
    if(seen.has(key)) return false;
    seen.add(key);
    return true;
  }).sort((a,b) => a.title.localeCompare(b.title));
}

function renderCompareSearch(){
  const input = document.getElementById("compareSearch");
  const results = document.getElementById("compareSearchResults");
  const summary = document.getElementById("compareSelectedSummary");
  if(!input || !results || !summary) return;

  const q = input.value.trim().toLowerCase();
  const all = getComparePrograms();
  const filtered = (q ? all.filter(r => `${r.title} ${r.type} ${r.required} ${r.tests}`.toLowerCase().includes(q)) : all).slice(0, 18);

  summary.textContent = `${COMPARE_SELECTED.length} of 3 selected.`;
  results.innerHTML = filtered.map(r => {
    const selected = COMPARE_SELECTED.some(x => x.title === r.title && x.type === r.type);
    return `
      <article class="card">
        <div class="uni-name">${compareEscape(r.type)}</div>
        <h3>${compareEscape(r.title)}</h3>
        <div class="note"><strong>Required:</strong> ${compareEscape(r.required).slice(0,220)}${r.required.length>220 ? "..." : ""}</div>
        <button class="tinybtn ${selected ? "secondary" : ""}" onclick='toggleCompare(${JSON.stringify(r.title)}, ${JSON.stringify(r.type)})'>${selected ? "Remove" : "Add to compare"}</button>
      </article>`;
  }).join("");
  renderCompareOutput();
}

function toggleCompare(title, type){
  const idx = COMPARE_SELECTED.findIndex(x => x.title === title && x.type === type);
  if(idx >= 0){
    COMPARE_SELECTED.splice(idx, 1);
  } else {
    if(COMPARE_SELECTED.length >= 3){
      alert("You can compare up to 3 programs at a time.");
      return;
    }
    const item = getComparePrograms().find(x => x.title === title && x.type === type);
    if(item) COMPARE_SELECTED.push(item);
  }
  renderCompareSearch();
}

function clearCompare(){
  COMPARE_SELECTED.length = 0;
  const input = document.getElementById("compareSearch");
  if(input) input.value = "";
  renderCompareSearch();
}

function renderCompareOutput(){
  const out = document.getElementById("compareOutput");
  if(!out) return;
  if(COMPARE_SELECTED.length === 0){
    out.innerHTML = `<p class="summary">Choose up to 3 programs to build a side-by-side comparison.</p>`;
    return;
  }
  const rows = [
    ["Program", r => `<strong>${compareEscape(r.title)}</strong><br><span class="note">${compareEscape(r.type)}</span>`],
    ["Required courses", r => compareEscape(r.required)],
    ["Recommended courses", r => compareEscape(r.recommended)],
    ["Average range / GPA", r => compareEscape(r.average)],
    ["Supp app / test", r => compareEscape(r.tests)],
    ["Source link", r => `<a href="${compareEscape(r.url)}" target="_blank" rel="noopener">${compareEscape(r.source)}</a>`]
  ];
  out.innerHTML = `
    <table class="compare-table">
      <thead><tr><th>Compare</th>${COMPARE_SELECTED.map((_,i)=>`<th>Program ${i+1}</th>`).join("")}</tr></thead>
      <tbody>
        ${rows.map(([label, fn]) => `<tr><th>${label}</th>${COMPARE_SELECTED.map(r => `<td>${fn(r)}</td>`).join("")}</tr>`).join("")}
      </tbody>
    </table>`;
}

document.addEventListener("input", (e) => {
  if(e.target && e.target.id === "compareSearch") renderCompareSearch();
});
setTimeout(renderCompareSearch, 0);

go("start");
