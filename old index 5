    b.innerHTML = `${c.short}<small>${c.name}</small>`;
    b.onclick = () => {
      ADVISOR_SELECTED.has(c.code) ? ADVISOR_SELECTED.delete(c.code) : ADVISOR_SELECTED.add(c.code);
      b.setAttribute("aria-pressed", ADVISOR_SELECTED.has(c.code));
    };
    el.appendChild(b);
  });
}

function advisorMissing(program){
  return program.req.filter(clause => !clause.some(code => ADVISOR_SELECTED.has(code)));
}

function advisorClauseLabel(program, clause){
  return program.labels?.[clause.join(",")] || clause.join(" or ");
}

function advisorBandRank(program){
  if(program.band === "green") return 1;
  if(program.band === "amber") return 2;
  if(program.band === "red") return 3;
  return 2;
}

function advisorAverageFit(program, average){
  if(!average) return "Average not entered";
  const rank = advisorBandRank(program);
  if(rank === 1) return average >= 84 ? "Likely range match" : "May need a higher average";
  if(rank === 2) return average >= 88 ? "Competitive range match" : "Reach based on average";
  if(rank === 3) return average >= 92 ? "Very competitive but possible" : "Extreme reach based on average";
  return "Check the official average range";
}

function advisorGoalScore(program, goal){
  const text = `${program.uni} ${program.name} ${program.note || ""}`.toLowerCase();
  let score = 0;

  if(goal === "medicine"){
    if(text.includes("health sciences") || text.includes("medical sciences") || text.includes("biomedical") || text.includes("life sciences")) score += 4;
    if(text.includes("biology") || text.includes("biochemistry") || text.includes("neuroscience")) score += 3;
    if(text.includes("kinesiology") || text.includes("nursing")) score += 1;
  }

  if(goal === "dentistry" || goal === "pharmacy" || goal === "optom"){
    if(text.includes("biomedical") || text.includes("biochemistry") || text.includes("life sciences") || text.includes("medical sciences")) score += 4;
    if(text.includes("biology") || text.includes("health sciences")) score += 3;
    if(text.includes("kinesiology") || text.includes("nursing")) score += 1;
  }

  if(goal === "physio" || goal === "chiro"){
    if(text.includes("kinesiology") || text.includes("health sciences")) score += 4;
    if(text.includes("biology") || text.includes("biomedical") || text.includes("life sciences")) score += 2;
    if(text.includes("nursing")) score += 1;
  }

  if(goal === "pa"){
    if(text.includes("health sciences") || text.includes("biomedical") || text.includes("life sciences") || text.includes("kinesiology")) score += 3;
    if(text.includes("nursing") || text.includes("biology")) score += 2;
  }

  if(goal === "nursing"){
    if(text.includes("nursing")) score += 6;
    if(text.includes("health sciences")) score += 2;
  }

  if(goal === "unsure"){
    if(text.includes("health sciences") || text.includes("life sciences") || text.includes("biology") || text.includes("kinesiology")) score += 3;
  }

  return score;
}

function advisorCard(program, extra){
  const missing = advisorMissing(program);
  const missingText = missing.length
    ? `Missing: ${missing.map(cl => advisorClauseLabel(program, cl)).join("; ")}`
    : "Course prerequisites covered";

  const source = program.url
    ? `<a href="${program.url}" target="_blank" rel="noopener">${program.src || "official page"}</a>`
    : (program.src || "official page");

  return `
    <div class="mini-item">
      <strong>${program.name}</strong>
      <small>${program.uni}</small>
      <small>${extra}</small>
      <small>${missingText}</small>
      <small>Source: ${source}</small>
    </div>`;
}

function runAdvisor(){
  const average = parseFloat(document.getElementById("advisorAverage").value);
  const grade = document.getElementById("advisorGrade").value;
  const goal = document.getElementById("advisorGoal").value;
  const out = document.getElementById("advisorResults");

  const selectedCourses = [...ADVISOR_SELECTED];
  const hasCourses = selectedCourses.length > 0;

  const evaluated = HS_PROGRAMS.map(p => {
    const missing = advisorMissing(p);
    const goalScore = advisorGoalScore(p, goal);
    const bandRank = advisorBandRank(p);
    const avgPenalty = average ? Math.max(0, (bandRank === 3 ? 92 : bandRank === 2 ? 88 : 84) - average) : 0;
    const score = goalScore + (missing.length === 0 ? 5 : Math.max(0, 3 - missing.length)) - avgPenalty / 4;
    return {program:p, missing, score, goalScore};
  }).filter(item => item.goalScore > 0 || goal === "unsure");

  const open = evaluated.filter(x => hasCourses && x.missing.length === 0)
    .sort((a,b) => b.score - a.score)
    .slice(0,6);

  const almost = evaluated.filter(x => x.missing.length > 0 && x.missing.length <= 2)
    .sort((a,b) => a.missing.length - b.missing.length || b.score - a.score)
    .slice(0,6);

  const reach = evaluated.filter(x => x.missing.length === 0)
    .filter(x => {
      const fit = advisorAverageFit(x.program, average).toLowerCase();
      return fit.includes("reach") || fit.includes("extreme") || fit.includes("very competitive");
    })
    .sort((a,b) => advisorBandRank(b.program) - advisorBandRank(a.program))
    .slice(0,4);

  const missingCounts = {};
  evaluated.forEach(x => x.missing.forEach(cl => {
    const label = advisorClauseLabel(x.program, cl);
    missingCounts[label] = (missingCounts[label] || 0) + 1;
  }));
  const topMissing = Object.entries(missingCounts).sort((a,b) => b[1] - a[1]).slice(0,4);

  const courseNames = selectedCourses.length
    ? HS_COURSES.filter(c => ADVISOR_SELECTED.has(c.code)).map(c => c.short).join(", ")
    : "No courses selected yet";

  const gradeAdvice = grade === "11"
    ? "Because you are in Grade 11, focus on unlocking the Grade 12 courses: ENG4U, SBI4U, SCH4U and at least one Grade 12 math. MCR3U is especially important because it opens Advanced Functions, Calculus and Data Management."
    : grade === "10"
      ? "Because you are in Grade 10 or earlier, stay in the academic/de-streamed math and science path so Grade 11 Biology, Chemistry and Functions stay available."
      : grade === "uni"
        ? "Because you are already in university, use this as an undergrad-program reference, then check the professional-school pages for course prerequisites."
        : "Because you are in Grade 12, use this to check which undergrad programs your current courses keep open.";

  out.innerHTML = `
    <div class="panel result-section">
      <h3>Your snapshot</h3>
      <p class="note"><strong>Goal:</strong> ${document.getElementById("advisorGoal").selectedOptions[0].text}</p>
      <p class="note"><strong>Average:</strong> ${average ? average + "%" : "Not entered"}</p>
      <p class="note"><strong>Courses:</strong> ${courseNames}</p>
      <div class="caution">${gradeAdvice}</div>
    </div>

    <div class="panel result-section">
      <h3>Best matches from your current courses</h3>
      <p class="note">${open.length ? "These match your selected courses and fit your goal best." : "Select more courses to see open program matches."}</p>
      <div class="mini-list">
        ${open.length ? open.map(x => advisorCard(x.program, advisorAverageFit(x.program, average))).join("") : ""}
      </div>
    </div>

    <div class="panel result-section">
      <h3>Programs that are close</h3>
      <p class="note">${almost.length ? "These are blocked by only one or two course requirement groups." : "No close blocked programs found with your current selection."}</p>
      <div class="mini-list">
        ${almost.length ? almost.map(x => advisorCard(x.program, `${x.missing.length} missing requirement group${x.missing.length === 1 ? "" : "s"}`)).join("") : ""}
      </div>
    </div>

    <div class="panel result-section">
      <h3>Reach check</h3>
      <p class="note">${reach.length ? "These have prerequisites covered but may be competitive based on the average band shown on this site." : "No reach programs found from your currently open list, or no average was entered."}</p>
      <div class="mini-list">
        ${reach.length ? reach.map(x => advisorCard(x.program, advisorAverageFit(x.program, average))).join("") : ""}
      </div>
    </div>

    <div class="panel result-section">
      <h3>What to fix first</h3>
      <p class="note">${topMissing.length ? "The most common missing items across your matching programs are:" : "No major missing course pattern found."}</p>
      <ul>
        ${topMissing.map(([label,count]) => `<li><span class="code">${count}</span> ${label}</li>`).join("")}
      </ul>
    </div>
  `;
}

initAdvisor();


