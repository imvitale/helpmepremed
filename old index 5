<!DOCTYPE html>
<html lang="en">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0">
<title>Help Me Pre Med | Ontario Pre-Med Path Finder</title>
<link rel="preconnect" href="https://fonts.googleapis.com">
<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
<link href="https://fonts.googleapis.com/css2?family=Bricolage+Grotesque:opsz,wght@12..96,400..800&family=Hanken+Grotesk:ital,wght@0,400..800;1,400..600&display=swap" rel="stylesheet">
<style>
  :root{
    /* warm, slightly unexpected palette: oat paper, ink, muted plum + clay */
    --ink:#2A2622; --paper:#F3EEE3; --card:#FBF8F1; --line:#DAD2C2;
    --plum:#6E4B63; --plum-soft:#EADFE6; --clay:#B5663F; --clay-soft:#F0E0D3;
    --open:#4F6F52; --closed:#A8493C; --muted:#7A7166;
  }
  *{box-sizing:border-box;margin:0;padding:0}
  body{background:var(--paper);color:var(--ink);font-family:'Hanken Grotesk',sans-serif;font-size:17.5px;line-height:1.6;
    background-image:radial-gradient(circle at 1px 1px, rgba(42,38,34,.045) 1px, transparent 0);background-size:22px 22px}
  a{color:var(--plum);text-decoration-thickness:1px;text-underline-offset:2px}
  .wrap{max-width:860px;margin:0 auto;padding:0 22px}

  header{border-bottom:1px solid var(--ink);padding:30px 0 56px}
  .topbar{display:flex;align-items:center;justify-content:space-between;gap:16px;flex-wrap:wrap}
  .aboutlink{font-family:'Hanken Grotesk',sans-serif;font-weight:600;font-size:14.5px;letter-spacing:0;color:var(--ink);background:none;border:none;border-bottom:1.5px solid var(--ink);border-radius:0;padding:4px 2px;cursor:pointer;transition:color .15s, border-color .15s;white-space:nowrap}
  .aboutlink:hover{color:var(--clay);border-color:var(--clay)}
  .brandrow{display:flex;align-items:center;gap:13px;cursor:pointer;width:max-content}
  .logo{width:44px;height:44px;flex:none}
  .brand{font-family:'Bricolage Grotesque',sans-serif;font-weight:800;font-size:clamp(26px,4.6vw,40px);letter-spacing:-.8px;line-height:1}
  .brand .uni{font-style:normal;color:var(--plum);border-bottom:2px solid var(--clay);padding-bottom:1px}
  .crumbs{margin-top:14px;font-family:'Hanken Grotesk',sans-serif;font-weight:500;font-size:12px;letter-spacing:.02em;color:var(--muted);min-height:16px;overflow-wrap:anywhere;text-transform:lowercase}
  .crumbs button{font:inherit;color:inherit;background:none;border:none;cursor:pointer;text-decoration:underline;padding:0}
  .crumbs span::before{content:" / "}

  main{padding:56px 0 80px}
  .screen{display:none}
  .screen.active{display:block;animation:rise .24s ease}
  @keyframes rise{from{opacity:0;transform:translateY(6px)}to{opacity:1;transform:none}}
  @media (prefers-reduced-motion:reduce){.screen.active{animation:none}}

  h1{font-family:'Bricolage Grotesque',sans-serif;font-weight:800;font-size:clamp(30px,4.8vw,46px);line-height:1.08;letter-spacing:-1px;margin-top:14px;margin-bottom:14px;max-width:18ch}
  .sub{color:var(--muted);margin-bottom:30px;max-width:56ch;font-size:18px}

  .bigbtns{display:grid;gap:16px;grid-template-columns:repeat(auto-fit,minmax(230px,1fr))}
  .bigbtn{background:var(--card);border:1px solid var(--line);border-radius:3px;padding:26px 24px;text-align:left;cursor:pointer;
    font-family:inherit;position:relative;transition:border-color .15s ease, background .15s ease, transform .12s ease}
  .bigbtn::before{content:"";position:absolute;left:0;top:0;bottom:0;width:3px;background:var(--clay);opacity:0;transition:opacity .15s ease}
  .bigbtn:hover{border-color:var(--ink);transform:translateY(-2px)}
  .bigbtn:hover::before{opacity:1}
  .bigbtn:focus-visible{outline:2px solid var(--plum);outline-offset:3px}
  .bigbtn .k{font-family:'Bricolage Grotesque',sans-serif;font-weight:700;font-size:25px;line-height:1.1;display:block;margin-bottom:5px}
  .bigbtn .d{font-size:15.5px;color:var(--muted);line-height:1.45}
  .shortcut{margin-top:20px;width:100%;background:var(--plum-soft);border-color:#cdb8c6}

  .panel{background:var(--card);border:1px solid var(--line);border-radius:3px;padding:22px 24px;margin-bottom:16px}
  .panel h3{font-family:'Bricolage Grotesque',sans-serif;font-weight:700;font-size:22px;margin-bottom:8px}
  .panel ul{padding-left:20px;display:flex;flex-direction:column;gap:7px;font-size:16px}
  .code{font-family:'Hanken Grotesk',sans-serif;font-weight:600;background:var(--clay-soft);color:var(--clay);padding:1px 6px;border-radius:3px;font-size:.82em;white-space:nowrap}
  .caution{font-size:14.5px;background:var(--plum-soft);border-left:3px solid var(--plum);border-radius:0 3px 3px 0;padding:12px 16px;margin-top:16px;color:#54414e}
  .linkbtn{font:inherit;background:none;border:none;color:var(--plum);font-weight:500;text-decoration:underline;cursor:pointer;padding:0}
  .back{margin-top:32px;font-family:'Hanken Grotesk',sans-serif;font-weight:600;font-size:14.5px;letter-spacing:0;color:var(--ink);background:none;border:none;border-bottom:1.5px solid var(--ink);border-radius:0;padding:4px 2px;cursor:pointer;transition:color .15s, border-color .15s}
  .back:hover{color:var(--clay);border-color:var(--clay)}

  .chips{display:flex;flex-wrap:wrap;gap:9px;margin-bottom:28px}
  .chip{font-family:'Hanken Grotesk',sans-serif;font-weight:500;font-size:13px;border:1px solid var(--line);background:var(--card);
    border-radius:3px;padding:9px 13px;cursor:pointer;display:flex;flex-direction:column;align-items:flex-start;gap:1px;user-select:none;transition:border-color .12s ease, background .12s ease}
  .chip small{font-family:'Hanken Grotesk',sans-serif;font-weight:500;font-size:10px;color:var(--muted)}
  .chip:hover{border-color:var(--ink)}
  .chip:focus-visible{outline:2px solid var(--plum);outline-offset:2px}
  .chip[aria-pressed="true"]{background:var(--plum);border-color:var(--plum);color:var(--card)}
  .chip[aria-pressed="true"] small{color:var(--plum-soft)}
  .summary{font-size:15px;color:var(--muted);margin-bottom:18px;font-style:italic}
  .grid{display:grid;grid-template-columns:repeat(auto-fill,minmax(300px,1fr));gap:18px}
  .card{background:var(--card);border:1px solid var(--line);border-radius:3px;padding:22px;display:flex;flex-direction:column;gap:11px}
  .card .uni-name{font-family:'Hanken Grotesk',sans-serif;font-size:11px;letter-spacing:.03em;text-transform:uppercase;color:var(--clay)}
  .card h3{font-family:'Bricolage Grotesque',sans-serif;font-weight:700;font-size:23px;line-height:1.1}
  .status{font-family:'Hanken Grotesk',sans-serif;font-weight:500;font-size:11px;border-radius:99px;padding:4px 12px;align-self:flex-start;text-transform:uppercase;letter-spacing:.04em}
  .status.open{background:var(--open);color:#fff}
  .status.missing{background:var(--closed);color:#fff}
  .status.neutral{background:var(--line);color:var(--ink)}
  .badgerow{display:flex;flex-wrap:wrap;gap:8px;align-items:center}
  .diff{display:inline-flex;align-items:center;gap:6px;font-size:12px;font-weight:600;color:var(--ink);background:var(--paper);border:1px solid var(--line);border-radius:99px;padding:3px 10px}
  .diffdot{width:9px;height:9px;border-radius:50%;flex:none}
  .legend{display:flex;flex-wrap:wrap;gap:14px;margin-bottom:18px;font-size:13px;color:var(--muted)}
  .legend span{display:inline-flex;align-items:center;gap:6px}
  .legend i{width:9px;height:9px;border-radius:50%;display:inline-block}
  ul.req{list-style:none;display:flex;flex-direction:column;gap:6px;font-size:15.5px;padding:0}
  ul.req li{display:flex;gap:9px;align-items:baseline}
  ul.req .mark{font-family:'Hanken Grotesk',sans-serif;font-weight:600;width:1.1em;flex:none;color:var(--clay)}
  li.have .mark{color:var(--open)} li.need .mark{color:var(--closed)}
  li.need{font-weight:500}
  .note{font-size:14.5px;color:var(--muted);line-height:1.5}
  .src{font-size:12.5px;color:var(--muted);margin-top:auto;padding-top:8px;border-top:1px solid var(--line)}


  .fieldlabel{display:block;margin:14px 0 6px;font-weight:700;color:var(--ink)}
  .fieldinput{width:100%;border:1px solid var(--line);background:var(--card);color:var(--ink);border-radius:3px;padding:12px 13px;font:inherit}
  .fieldinput:focus{outline:2px solid var(--plum);outline-offset:2px}
  .advisor-panel .chips{margin-bottom:12px}
  .advisor-action{width:100%;margin-top:14px;background:var(--plum-soft);border-color:#cdb8c6}

  .compare-row{display:grid;grid-template-columns:1fr auto;gap:10px;margin-bottom:16px}
  .compare-results{display:grid;grid-template-columns:repeat(auto-fit,minmax(260px,1fr));gap:16px;margin-top:18px}
  .compare-table{width:100%;border-collapse:collapse;font-size:14px;margin-top:18px;background:var(--card);border:1px solid var(--line)}
  .compare-table th,.compare-table td{border:1px solid var(--line);padding:12px;vertical-align:top;text-align:left}
  .compare-table th{font-family:'Bricolage Grotesque',sans-serif;background:var(--plum-soft);font-size:15px}
  .tinybtn{font:inherit;font-weight:700;background:var(--plum);color:var(--card);border:1px solid var(--plum);border-radius:3px;padding:9px 13px;cursor:pointer}
  .tinybtn.secondary{background:var(--card);color:var(--ink);border-color:var(--line)}
  .result-section{margin-top:18px}
  .mini-list{display:flex;flex-direction:column;gap:10px;margin-top:10px}
  .mini-item{border:1px solid var(--line);background:var(--card);border-radius:3px;padding:14px 16px}
  .mini-item strong{display:block;font-family:'Bricolage Grotesque',sans-serif;font-size:18px;line-height:1.15}
  .mini-item small{display:block;color:var(--muted);margin-top:3px}

  footer{border-top:1px solid var(--ink);margin-top:40px;padding:32px 0 54px;font-size:14px;color:var(--muted)}
  footer .feedback{margin-top:18px;color:var(--ink);font-weight:500}

  @media (max-width:520px){
    .wrap{padding:0 16px}
    body{font-size:16.5px}
    main{padding:30px 0 56px}
    header{padding:24px 0 44px}
    .bigbtns{grid-template-columns:1fr}
    .bigbtn{padding:20px 18px}
    .chip{padding:8px 11px}
    .panel{padding:18px}
    .logo{width:38px;height:38px}
  }
</style>
</head>
<body>

<header>
  <div class="wrap">
    <div class="topbar">
      <div class="brandrow" onclick="go('start')">
        <svg class="logo" viewBox="0 0 64 64" xmlns="http://www.w3.org/2000/svg" aria-hidden="true">
          <polygon points="32,10 58,22 32,34 6,22" fill="#2A2622"/>
          <path d="M20 28 v10 c0 4 5.5 7 12 7 s12-3 12-7 V28 L32 34 Z" fill="#EADFE6" stroke="#2A2622" stroke-width="2.5"/>
          <line x1="58" y1="22" x2="58" y2="40" stroke="#2A2622" stroke-width="3" stroke-linecap="round"/>
          <circle cx="58" cy="44" r="4" fill="#B5663F" stroke="#2A2622" stroke-width="2.5"/>
          <circle cx="27" cy="21" r="1.8" fill="#6E4B63"/>
          <circle cx="37" cy="21" r="1.8" fill="#6E4B63"/>
          <path d="M27 25 q5 3.5 10 0" stroke="#6E4B63" stroke-width="2" fill="none" stroke-linecap="round"/>
        </svg>
        <div class="brand">Help Me <span class="uni">Pre Med</span></div>
      </div>
      <button class="aboutlink" onclick="go('about')">About the Founder</button>
    </div>
    <div class="crumbs" id="crumbs"></div>
  </div>
</header>

<main class="wrap">

  <!-- START -->
  <section class="screen" id="s-start">
    <h1>Where are you right now?</h1>
    <p class="sub">A student-built map from where you are now to the program you're aiming at. Every requirement links back to the official page it came from, so you can check it yourself.</p>
    <div class="bigbtns">
      <button class="bigbtn" onclick="go('hs')"><span class="k">High school</span><span class="d">Find the courses that keep university doors open, grade by grade.</span></button>
      <button class="bigbtn" onclick="go('ug')"><span class="k">Undergraduate</span><span class="d">Check yourself against med, dental, pharmacy, physio, PA, optometry, chiro and nursing schools.</span></button>
    </div>
    <button class="bigbtn shortcut" onclick="go('advisor')"><span class="k">Find Your Path Advisor</span><span class="d">Answer a few questions and get eligible programs, reach options, missing courses and next steps.</span></button>
    <button class="bigbtn shortcut" onclick="go('compare')"><span class="k">Compare 3 programs</span><span class="d">Search undergraduate and professional programs, choose up to 3, and compare courses, averages, tests and source links.</span></button>
  </section>

  <!-- FIND MY PATH AI -->
  <section class="screen" id="s-advisor">
    <h1>Find Your Path Advisor</h1>
    <p class="sub">This is a rule-based advisor using the program data already on this site. Pick your grade, courses, average and goal to get a personalized starting point.</p>

    <div class="panel advisor-panel">
      <h3>1. Tell us your plan</h3>

      <label class="fieldlabel" for="advisorGrade">Grade</label>
      <select id="advisorGrade" class="fieldinput">
        <option value="12">Grade 12</option>
        <option value="11">Grade 11</option>
        <option value="10">Grade 10 or earlier</option>
        <option value="uni">University student</option>
      </select>

      <label class="fieldlabel" for="advisorAverage">Estimated admission average</label>
      <input id="advisorAverage" class="fieldinput" type="number" min="50" max="100" step="0.1" placeholder="Example: 89">

      <label class="fieldlabel" for="advisorGoal">Healthcare goal</label>
      <select id="advisorGoal" class="fieldinput">
        <option value="medicine">Medicine</option>
        <option value="dentistry">Dentistry</option>
        <option value="physio">Physiotherapy</option>
        <option value="pa">Physician Assistant</option>
        <option value="pharmacy">Pharmacy</option>
        <option value="nursing">Nursing</option>
        <option value="optom">Optometry</option>
        <option value="chiro">Chiropractic</option>
        <option value="unsure">I'm not sure yet</option>
      </select>

      <div class="fieldlabel">Grade 12 courses you have or plan to take</div>
      <div class="chips" id="advisorCourses" role="group" aria-label="Advisor course selection"></div>

      <button class="bigbtn advisor-action" onclick="runAdvisor()"><span class="k">Generate my path</span><span class="d">Show eligible programs, reach options and missing courses.</span></button>
    </div>

    <div id="advisorResults"></div>
    <button class="back" onclick="go('start')">← Back to start</button>
  </section>

  <!-- COMPARE PROGRAMS -->
  <section class="screen" id="s-compare">
    <h1>Compare 3 programs</h1>
    <p class="sub">Search the programs already in Help Me Pre Med, choose up to 3, and compare requirements side by side. This includes the current undergraduate database and professional/graduate pathways already listed on the site.</p>

    <div class="panel">
      <h3>Search programs</h3>
      <div class="compare-row">
        <input id="compareSearch" class="fieldinput" type="search" placeholder="Example: Waterloo Health Sciences, dentistry, McMaster, pharmacy">
        <button class="tinybtn secondary" onclick="clearCompare()">Clear</button>
      </div>
      <p class="summary" id="compareSelectedSummary">0 of 3 selected.</p>
      <div class="grid" id="compareSearchResults"></div>
    </div>

    <div id="compareOutput"></div>

    <div class="caution">Comparison uses the program data currently stored on this site. Always confirm final requirements on the official source link before applying.</div>
    <button class="back" onclick="go('start')">← Back to start</button>
  </section>

  <!-- HS GRADE PICK -->
  <section class="screen" id="s-hs">
    <h1>What grade are you in?</h1>
    <p class="sub">Pick your current grade. We'll show what to do this year.</p>
    <div class="bigbtns">
      <button class="bigbtn" onclick="go('g9')"><span class="k">Grade 9</span><span class="d">Build the foundation</span></button>
      <button class="bigbtn" onclick="go('g10')"><span class="k">Grade 10</span><span class="d">Stay on the academic track</span></button>
      <button class="bigbtn" onclick="go('g11')"><span class="k">Grade 11</span><span class="d">Your Grade 12 options are decided here</span></button>
      <button class="bigbtn" onclick="go('g12')"><span class="k">Grade 12</span><span class="d">Check your plan against real requirements</span></button>
    </div>
    <button class="back" onclick="go('start')">← Back</button>
  </section>

  <!-- GRADE 9 -->
  <section class="screen" id="s-g9">
    <h1>Grade 9: keep every door open</h1>
    <p class="sub">No university looks at Grade 9 marks. Your only job is to stay on the course track that leads to Grade 12 U-level courses.</p>
    <div class="panel">
      <h3>Take this year</h3>
      <ul>
        <li><span class="code">ENG1D</span> English, which starts the chain to ENG4U (required everywhere)</li>
        <li><span class="code">MTH1W</span> Math (de-streamed), which starts the chain to Grade 12 math and calculus</li>
        <li><span class="code">SNC1W</span> Science, which starts the chain to Grade 12 Biology, Chemistry and Physics</li>
      </ul>
    </div>
    <div class="panel">
      <h3>One habit that pays off later</h3>
      <ul><li>Pick at least one arts or humanities course you actually like. McMaster Health Sci requires a non-math, non-science Grade 12 course, and it's easier if you've stayed in the habit.</li></ul>
    </div>
    <div class="caution">Course codes reflect Ontario's current curriculum. Confirm exact codes with your guidance counselor, as the Ministry occasionally renames them.</div>
    <button class="back" onclick="go('hs')">← Back to grades</button>
  </section>

  <!-- GRADE 10 -->
  <section class="screen" id="s-g10">
    <h1>Grade 10: the chain continues</h1>
    <p class="sub">These three academic courses are the prerequisites for the Grade 11 courses that matter. Dropping to applied level here closes the U-level path.</p>
    <div class="panel">
      <h3>Take this year</h3>
      <ul>
        <li><span class="code">ENG2D</span> English (academic) → leads to ENG3U → ENG4U</li>
        <li><span class="code">MPM2D</span> Principles of Mathematics (academic) → leads to MCR3U → MHF4U / MCV4U / MDM4U</li>
        <li><span class="code">SNC2D</span> Science (academic) → the single gateway to Grade 11 Biology, Chemistry AND Physics</li>
      </ul>
    </div>
    <div class="caution">Confirm course codes and prerequisites with your guidance counselor. Chains can vary slightly by school board.</div>
    <button class="back" onclick="go('hs')">← Back to grades</button>
  </section>

  <!-- GRADE 11 -->
  <section class="screen" id="s-g11">
    <h1>Grade 11: set up your Grade 12 options</h1>
    <p class="sub">Universities mostly look at Grade 12 marks, but every Grade 12 course has a Grade 11 prerequisite. What you pick now determines what you <em>can</em> pick next year.</p>
    <div class="panel">
      <h3>To keep every flagship health program open next year, take:</h3>
      <ul>
        <li><span class="code">ENG3U</span> English → unlocks ENG4U (required by every program)</li>
        <li><span class="code">SBI3U</span> Biology → unlocks SBI4U (required at McMaster, Western, Queen's and Waterloo Health Sci)</li>
        <li><span class="code">SCH3U</span> Chemistry → unlocks SCH4U (required at McMaster, Western Med Sci, Queen's and Waterloo Health Sci)</li>
        <li><span class="code">MCR3U</span> Functions → unlocks ALL Grade 12 math, including Calculus</li>
        <li><span class="code">SPH3U</span> Physics (optional) → unlocks SPH4U, recommended at Western Med Sci</li>
      </ul>
    </div>
    <div class="panel">
      <h3>The trap to avoid</h3>
      <ul><li>Skipping <span class="code">MCR3U</span> (Functions) means no Calculus next year, which closes Western Medical Sciences, U of T Life Sciences and Waterloo Life Sciences for direct entry. It's the most door-closing single decision in high school. Tap through to the Grade 12 checker to see it live.</li></ul>
    </div>
    <div class="caution">Confirm prerequisites with your guidance counselor before finalizing your timetable.</div>
    <button class="back" onclick="go('hs')">← Back to grades</button>
  </section>

  <!-- GRADE 12 CHECKER -->
  <section class="screen" id="s-g12">
    <h1>Grade 12: check your plan</h1>
    <p class="sub">Tap the courses you'll have by the end of Grade 12. Each program flips live between open and blocked, and shows how competitive its admission average is. Nursing is here too, because it's direct entry from high school.</p>
    <div class="chips" id="chips" role="group" aria-label="Grade 12 course selection"></div>
    <div class="panel" style="margin-top:-8px;margin-bottom:18px">
      <label class="fieldlabel" for="g12ProgramSearch">Search for a program</label>
      <input id="g12ProgramSearch" class="fieldinput" type="search" placeholder="Example: McMaster Health Sciences, Waterloo Kinesiology, Nursing">
      <p class="note" style="margin-top:8px">Search by university or program name. Your selected courses stay saved while you search.</p>
    </div>
    <p class="summary" id="summary"></p>
    <div class="badgerow" style="margin:-6px 0 20px">
      <button class="tinybtn" onclick="copyGrade12Plan()">Copy/share my plan</button>
      <button class="tinybtn secondary" onclick="window.print()">Print / save as PDF</button>
    </div>
    <p class="summary" id="shareStatus" aria-live="polite"></p>
    <div class="legend" id="g12legend"></div>
    <div class="grid" id="grid"></div>
    <button class="back" onclick="go('hs')">← Back to grades</button>
  </section>

  <!-- UNIVERSITY: field chooser -->
  <section class="screen" id="s-ug">
    <h1>University: pick a professional path</h1>
    <p class="sub">Each field is applied to during or after your undergraduate degree, and the required courses differ sharply between them. Pick a field to see every program with its full prerequisite course list.</p>
    <div class="bigbtns">
      <button class="bigbtn" onclick="go('med')"><span class="k">Medicine</span><span class="d">All 18 Canadian faculties, grouped by province</span></button>
      <button class="bigbtn" onclick="openField('dent')"><span class="k">Dentistry</span><span class="d">All 10 Canadian dental schools</span></button>
      <button class="bigbtn" onclick="openField('physio')"><span class="k">Physiotherapy</span><span class="d">All 16 Canadian PT programs</span></button>
      <button class="bigbtn" onclick="openField('optom')"><span class="k">Optometry</span><span class="d">OAT or CASPer; Waterloo and Montreal</span></button>
      <button class="bigbtn" onclick="openField('chiro')"><span class="k">Chiropractic</span><span class="d">CMCC Toronto and UQTR Quebec</span></button>
      <button class="bigbtn" onclick="openField('pa')"><span class="k">Physician Assistant</span><span class="d">All 6 Canadian PA programs</span></button>
      <button class="bigbtn" onclick="openField('pharmacy')"><span class="k">Pharmacy</span><span class="d">All 11 accredited PharmD schools in Canada</span></button>
      <button class="bigbtn" onclick="openField('nursing')"><span class="k">Accelerated Nursing</span><span class="d">Second-entry BScN for university grads</span></button>
    </div>
