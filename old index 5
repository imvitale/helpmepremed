/* ---------- navigation ---------- */
const TITLES = {start:"Start", hs:"High school", ug:"University", g9:"Grade 9", g10:"Grade 10", g11:"Grade 11", g12:"Grade 12", med:"Medical schools", field:"Programs", premed:"Undergrad majors", advisor:"Find Your Path Advisor", compare:"Compare 3 programs", about:"About the Founder"};
const PARENT  = {hs:"start", ug:"start", g9:"hs", g10:"hs", g11:"hs", g12:"hs", med:"ug", field:"ug", premed:"start", advisor:"start", compare:"start", about:"start"};
function go(id){
  document.querySelectorAll(".screen").forEach(s => s.classList.remove("active"));
  document.getElementById("s-"+id).classList.add("active");
  const trail = [];
  let cur = id;
  while(cur){ trail.unshift(cur); cur = PARENT[cur]; }
  document.getElementById("crumbs").innerHTML = trail.map((t,i) =>
    i===trail.length-1 ? (i===0 ? `<b style="color:var(--ink);font-weight:600">${TITLES[t]}</b>` : `<span style="color:var(--ink);font-weight:600">${TITLES[t]}</span>`)
    : (i===0 ? `<button onclick="go('${t}')">${TITLES[t]}</button>` : `<span><button onclick="go('${t}')">${TITLES[t]}</button></span>`)
  ).join("");
  window.scrollTo({top:0});
}

/* ---------- shared checker engine ---------- */
function buildChecker(courses, programs, chipsEl, gridEl, summaryEl, summaryFn){
  const selected = new Set();
  if(chipsEl){
    chipsEl._selectedCourses = selected;
    chipsEl._checkerPrograms = programs;
    chipsEl._checkerCourses = courses;
  }
  const searchEl = gridEl && gridEl.id === "grid" ? document.getElementById("g12ProgramSearch") : null;
  courses.forEach(c => {
    const b = document.createElement("button");
    b.className = "chip"; b.setAttribute("aria-pressed","false");
    b.innerHTML = `${c.short}<small>${c.name}</small>`;
    b.onclick = () => {
      selected.has(c.code) ? selected.delete(c.code) : selected.add(c.code);
      b.setAttribute("aria-pressed", selected.has(c.code));
      render();
    };
    chipsEl.appendChild(b);
  });
  function clauseLabel(p, clause){ return p.labels[clause.join(",")] || clause.join(" or "); }
  const BANDS = {
    green:{dot:"#4F6F52", label:"Moderate", range:"mid 80s"},
    amber:{dot:"#C99A3B", label:"Competitive", range:"high 80s"},
    red:{dot:"#A8493C", label:"Very competitive", range:"90%+"}
  };
  function bandBadge(p){
    const b = BANDS[p.band];
    if(!b) return `<span class="diff"><span class="diffdot" style="background:var(--line)"></span>Average not published</span>`;
    return `<span class="diff"><span class="diffdot" style="background:${b.dot}"></span>${b.label} (${b.range})</span>`;
  }
  function render(){
    const none = selected.size === 0;
    let openCount = 0;
    const query = searchEl ? searchEl.value.trim().toLowerCase() : "";
    const visiblePrograms = query
      ? programs.filter(p => `${p.uni} ${p.name} ${p.note || ""} ${p.src || ""}`.toLowerCase().includes(query))
      : programs;
    gridEl.innerHTML = "";
    visiblePrograms.forEach(p => {
      const missing = p.req.filter(cl => !cl.some(code => selected.has(code)));
      const open = !none && missing.length === 0;
      if (open) openCount++;
      const card = document.createElement("article");
      card.className = "card";
      const status = none ? `<span class="status neutral">Select above to check</span>`
        : open ? `<span class="status open">Open: requirements covered</span>`
        : `<span class="status missing">Missing ${missing.length} requirement${missing.length>1?"s":""}</span>`;
      const reqList = p.req.map(cl => {
        const have = cl.some(code => selected.has(code));
        const cls = none ? "" : (have ? "have" : "need");
        const mark = none ? "·" : (have ? "✓" : "✗");
        return `<li class="${cls}"><span class="mark">${mark}</span><span>${clauseLabel(p, cl)}</span></li>`;
      }).join("");
      card.innerHTML = `
        <div class="uni-name">${p.uni}</div><h3>${p.name}</h3>
        <div class="badgerow">${status}${bandBadge(p)}</div>
        <ul class="req">${reqList}</ul>
        ${p.rec ? `<div class="note"><strong>Recommended:</strong> ${p.rec}</div>` : ""}
        <div class="note">${p.note}</div>
        <div class="src">Source: <a href="${p.url}" target="_blank" rel="noopener">${p.src}</a> · verified 2026-06-11</div>`;
      gridEl.appendChild(card);
    });
    if(visiblePrograms.length === 0){
      gridEl.innerHTML = `<article class="card"><h3>No programs found</h3><div class="note">Try a university name, program name, or a broader search term like health, biology, nursing, Waterloo or McMaster.</div></article>`;
    }
    const baseSummary = summaryFn(none, openCount, visiblePrograms.length, selected);
    summaryEl.textContent = query
      ? `${baseSummary} Showing ${visiblePrograms.length} of ${programs.length} programs for “${searchEl.value.trim()}”.`
      : baseSummary;
  }
  if(searchEl){
    searchEl.addEventListener("input", render);
  }
  render();
}

